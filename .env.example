# ==============================================================================
# AI-Powered Job Search Assistant - Environment Variables Template
# ==============================================================================
# Single source of truth for all service environment variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control!

# ------------------------------------------------------------------------------
# General Configuration
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=jobassistant
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobassistant
DATABASE_URL=postgresql://postgres:postgres@db:5432/jobassistant
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MCP_URL=redis://redis:6379/2
CACHE_DEFAULT_TTL=3600

# ------------------------------------------------------------------------------
# API Keys (Required)
# ------------------------------------------------------------------------------
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Adzuna Job Search API - Get yours at: https://developer.adzuna.com/
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key
ADZUNA_COUNTRY=us

# ------------------------------------------------------------------------------
# Security Keys
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-secure-random-hex-string
JWT_SECRET_KEY=generate-another-secure-random-hex-string

# JWT Token Expiration (seconds)
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=604800

# ------------------------------------------------------------------------------
# Flask Configuration
# ------------------------------------------------------------------------------
FLASK_APP=src.app:create_app
FLASK_ENV=development
FLASK_DEBUG=1

# ------------------------------------------------------------------------------
# CORS Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# MCP Service Configuration
# ------------------------------------------------------------------------------
MCP_SERVICE_URL=http://mcp:8000
MCP_SERVICE_TIMEOUT=30
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_DEBUG=true
MCP_LOG_LEVEL=INFO

# Backend API URL for MCP service
BACKEND_API_URL=http://backend:5000/api
BACKEND_API_TIMEOUT=30
BACKEND_SERVICE_TOKEN=your-internal-service-token

# ------------------------------------------------------------------------------
# OpenAI Configuration (for MCP)
# ------------------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_RATE_LIMIT_RPM=60
OPENAI_RATE_LIMIT_TPM=100000

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# API URLs
REACT_APP_API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
REACT_APP_WS_URL=ws://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Application Settings
REACT_APP_TITLE=AI Job Search Assistant
NEXT_PUBLIC_TITLE=AI Job Search Assistant
REACT_APP_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Frontend Dev Settings
PORT=3000
GENERATE_SOURCEMAP=true
BROWSER=none
SKIP_PREFLIGHT_CHECK=true

# ------------------------------------------------------------------------------
# Email Configuration
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@jobassistant.com

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
RATELIMIT_ENABLED=false
RATELIMIT_STORAGE_URL=redis://redis:6379/1
RATELIMIT_DEFAULT=1000/hour
RATELIMIT_AUTH=20/minute
RATELIMIT_CHAT=100/minute
RATELIMIT_JOB_SEARCH=200/minute

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Development & Testing Options
# ------------------------------------------------------------------------------
# Use dummy data instead of external APIs (for development without API keys)
USE_DUMMY_DATA=true

# Skip email sending (for local development)
SKIP_EMAIL_SENDING=true

# Use mock OpenAI responses (for testing without API calls)
USE_MOCK_OPENAI=false

# ------------------------------------------------------------------------------
# Agent Configuration
# ------------------------------------------------------------------------------
AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY=1.0
AGENT_TIMEOUT=60

# ------------------------------------------------------------------------------
# Conversation Memory
# ------------------------------------------------------------------------------
CONVERSATION_MEMORY_TTL=86400
MAX_CONVERSATION_HISTORY=50

